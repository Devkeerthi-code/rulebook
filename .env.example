# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection string with the pgvector extension available.
# Neon: Project -> Connection details -> "Pooled connection". Keep ?sslmode=require (or verify-full).
# Example shape: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Google Gemini API key (free tier works): https://aistudio.google.com/apikey
# Used for embeddings, answers, OCR of scanned pages and starter questions.
GEMINI_API_KEY=

# Optional. Model used for answers, OCR and starter questions. Falls back to the flash models if it fails.
# GEMINI_CHAT_MODEL=gemini-flash-lite-latest

# Optional. Embedding model; must support 768-dimension output (the database column is vector(768)).
# GEMINI_EMBED_MODEL=gemini-embedding-001
